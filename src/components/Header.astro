---
interface Props {
  compact?: boolean;
  subtitle?: string;
}

const {
  compact = false,
  subtitle = "Compare states for HQ and expansion — CNBC 2025 rankings.",
} = Astro.props;

const path = Astro.url.pathname;
const primaryNav = [
  { href: "/", label: "Map", match: (p: string) => p === "/" },
  { href: "/rankings", label: "Rankings", match: (p: string) => p.startsWith("/rankings") },
  { href: "/compare", label: "Compare", match: (p: string) => p.startsWith("/compare") },
  { href: "/movers", label: "Movers", match: (p: string) => p.startsWith("/movers") },
];
const partnersActive = path.startsWith("/partners");
---

<header class:list={["site-header", { "site-header--compact": compact }]}>
  <a href="/" class="brand" aria-label="StateCompass home">
    <img src="/assets/logo.svg" alt="StateCompass" class="brand-logo" width="210" height="40" />
  </a>

  <nav class="site-nav" aria-label="Main">
    {
      primaryNav.map((item) => (
        <a
          href={item.href}
          class:list={["nav-link", { "is-active": item.match(path) }]}
          aria-current={item.match(path) ? "page" : undefined}
        >
          {item.label}
        </a>
      ))
    }
    <a
      href="/partners"
      class:list={["nav-link", "nav-link--partners-desktop", { "is-active": partnersActive }]}
      aria-current={partnersActive ? "page" : undefined}
    >
      Partners
    </a>
    <details class="nav-more">
      <summary class="nav-link nav-more-trigger">More</summary>
      <div class="nav-more-menu" role="menu">
        <a
          href="/partners"
          class:list={["nav-more-link", { "is-active": partnersActive }]}
          role="menuitem"
          aria-current={partnersActive ? "page" : undefined}
        >
          Partners
        </a>
      </div>
    </details>
  </nav>

  <p class="subtitle">{subtitle}</p>
</header>
