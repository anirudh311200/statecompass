---
import { BRAND_VERSION } from "../lib/site.js";

interface Props {
  compact?: boolean;
  subtitle?: string;
}

const {
  compact = false,
  subtitle = "Compare states for HQ and expansion — CNBC 2025 rankings.",
} = Astro.props;

const path = Astro.url.pathname;
const navItems = [
  { href: "/", label: "Map", match: (p) => p === "/" },
  { href: "/match", label: "Match", match: (p) => p.startsWith("/match") },
  { href: "/expand", label: "Expand", match: (p) => p.startsWith("/expand") },
  { href: "/rankings", label: "Rankings", match: (p) => p.startsWith("/rankings") },
  { href: "/compare", label: "Compare", match: (p) => p.startsWith("/compare") },
  { href: "/pulse", label: "Pulse", match: (p) => p.startsWith("/pulse") },
  { href: "/me", label: "Profile", match: (p) => p.startsWith("/me") },
  { href: "/movers", label: "Movers", match: (p) => p.startsWith("/movers") },
  {
    href: "/partners",
    label: "Partners",
    match: (p) => p.startsWith("/partners"),
  },
];
---

<header class:list={["site-header", { "site-header--compact": compact }]}>
  <a href="/" class="brand" aria-label="StateCompass home">
    <img
      src={`/assets/logo.svg?v=${BRAND_VERSION}`}
      alt="StateCompass"
      class="brand-logo"
      width="278"
      height="54"
    />
  </a>

  <nav class="site-nav" aria-label="Main">
    {
      navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            "nav-link",
            { "is-active": item.match(path) },
          ]}
          aria-current={item.match(path) ? "page" : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </nav>

  <p class="subtitle">{subtitle}</p>
</header>
