---
interface Props {
  compact?: boolean;
  subtitle?: string;
}

const {
  compact = false,
  subtitle = "Compare states for HQ and expansion — CNBC 2025 rankings.",
} = Astro.props;

const path = Astro.url.pathname;
const navItems = [
  { href: "/", label: "Map", match: (p) => p === "/" },
  { href: "/rankings", label: "Rankings", match: (p) => p.startsWith("/rankings") },
  { href: "/compare", label: "Compare", match: (p) => p.startsWith("/compare") },
  { href: "/movers", label: "Movers", match: (p) => p.startsWith("/movers") },
  {
    href: "/partners",
    label: "Partners",
    match: (p) => p.startsWith("/partners"),
    hideOnMobile: true,
  },
];
---

<header class:list={["site-header", { "site-header--compact": compact }]}>
  <a href="/" class="brand" aria-label="StateCompass home">
    <img src="/assets/logo.svg" alt="StateCompass" class="brand-logo" width="232" height="46" />
  </a>

  <nav class="site-nav" aria-label="Main">
    {
      navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            "nav-link",
            { "is-active": item.match(path), "nav-link--partners": item.hideOnMobile },
          ]}
          aria-current={item.match(path) ? "page" : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </nav>

  <p class="subtitle">{subtitle}</p>
</header>
