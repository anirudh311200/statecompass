---
import SnapshotDisclaimer from "./SnapshotDisclaimer.astro";
import { HEADS_UP_COMPARE_ROWS, HEADS_UP_SHARED_TITLE } from "../scripts/snapshotLabels.js";

interface SourcedFact {
  value: string;
  sourceUrl: string;
  sourceLabel: string;
}

interface SnapshotState {
  taxPosture: SourcedFact;
  businessRegistration: SourcedFact;
  complianceCalendar: SourcedFact;
  multiStateHeadsUp: SourcedFact[];
}

interface Props {
  stateName: string;
  snapshot: SnapshotState | null;
  disclaimer: string;
}

const { stateName, snapshot, disclaimer } = Astro.props;

const factSections = snapshot
  ? [
      { label: "Tax posture", fact: snapshot.taxPosture },
      { label: "Business registration", fact: snapshot.businessRegistration },
      { label: "Compliance calendar", fact: snapshot.complianceCalendar },
    ]
  : [];

const headsUpLabeled = snapshot
  ? HEADS_UP_COMPARE_ROWS.map(({ index, label }) => ({
      label,
      fact: snapshot.multiStateHeadsUp[index],
    })).filter((entry) => entry.fact)
  : [];

const headsUpShared = snapshot ? snapshot.multiStateHeadsUp.slice(2) : [];
---

<section class="panel founder-snapshot" id="founder-snapshot" aria-labelledby="snapshot-heading">
  <h2 id="snapshot-heading" class="panel-title">Founder Snapshot</h2>
  <p class="panel-helper">
    Lite operational context for {stateName} — what to know before operating here. Sourced
    public facts, separate from CNBC scores.
  </p>

  <SnapshotDisclaimer text={disclaimer} />

  {
    snapshot ? (
      <div class="snapshot-content">
        {
          factSections.map(({ label, fact }) => (
            <div class="snapshot-fact">
              <h3 class="snapshot-fact-label">{label}</h3>
              <p class="snapshot-fact-value">{fact.value}</p>
              <p class="snapshot-fact-source">
                Source:{" "}
                <a href={fact.sourceUrl} target="_blank" rel="noopener noreferrer">
                  {fact.sourceLabel}
                </a>
              </p>
            </div>
          ))
        }

        <div class="snapshot-fact snapshot-heads-up-group">
          <h3 class="snapshot-fact-label">Multi-state heads-up</h3>
          <p class="snapshot-fact-helper">
            If you operate outside {stateName} or hire remotely — informational, not legal advice.
          </p>

          {
            headsUpLabeled.map(({ label, fact }) => (
              <div class="snapshot-heads-up-row">
                <h4 class="snapshot-heads-up-row-label">{label}</h4>
                <p class="snapshot-fact-value">{fact.value}</p>
                <p class="snapshot-fact-source">
                  Source:{" "}
                  <a href={fact.sourceUrl} target="_blank" rel="noopener noreferrer">
                    {fact.sourceLabel}
                  </a>
                </p>
              </div>
            ))
          }

          {
            headsUpShared.length > 0 && (
              <div class="snapshot-shared-note">
                <h4 class="snapshot-heads-up-row-label">{HEADS_UP_SHARED_TITLE}</h4>
                <ul class="snapshot-heads-up-list">
                  {headsUpShared.map((bullet) => (
                    <li class="snapshot-heads-up-item">
                      <p class="snapshot-fact-value">{bullet.value}</p>
                      <p class="snapshot-fact-source">
                        Source:{" "}
                        <a href={bullet.sourceUrl} target="_blank" rel="noopener noreferrer">
                          {bullet.sourceLabel}
                        </a>
                      </p>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </div>
      </div>
    ) : (
      <p class="snapshot-coming-soon">Snapshot data for this state is coming soon.</p>
    )
  }
</section>
