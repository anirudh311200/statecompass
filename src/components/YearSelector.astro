---
interface Props {
  id?: string;
  label?: string;
  class?: string;
  variant?: "default" | "compact";
}

const {
  id = "year-select",
  label = "CNBC year",
  class: className = "",
  variant = "default",
} = Astro.props;

const isCompact = variant === "compact";
---

{
  isCompact ? (
    <div
      id={id}
      class:list={["year-toggle", className]}
      data-year-toggle
      role="group"
      aria-label={label}
    >
      <div class="year-toggle-track" data-year-toggle-track />
    </div>
  ) : (
    <div class:list={["year-select-wrap", className]}>
      <label class="toolbar-label" for={id}>
        {label}
      </label>
      <select id={id} class="year-select" data-year-select>
        <option value="2025">CNBC 2025</option>
        <option value="2024">CNBC 2024</option>
      </select>
    </div>
  )
}
