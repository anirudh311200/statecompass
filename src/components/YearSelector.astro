---
interface Props {
  id?: string;
  label?: string;
  class?: string;
}

const {
  id = "year-select",
  label = "CNBC year",
  class: className = "",
} = Astro.props;
---

<div class:list={["year-select-wrap", className]}>
  <label class="toolbar-label" for={id}>{label}</label>
  <select id={id} class="year-select" data-year-select>
    <option value="2025">CNBC 2025</option>
    <option value="2024">CNBC 2024</option>
  </select>
</div>
