---
import { dataYear } from "../lib/states.js";
import { METHODOLOGY_URL } from "../scripts/categories.js";
import { CNBC_RANKINGS_URL, cnbcSourceLabel } from "../lib/site.js";
---

<footer>
  <p class="footer-stack footer-source">
    <span>
      Scores from
      <a href={CNBC_RANKINGS_URL} target="_blank" rel="noopener noreferrer">
        {cnbcSourceLabel(dataYear)}
      </a>
    </span>
    <span class="footer-stack-sep" aria-hidden="true">·</span>
    <span>Normalized to 0–100 from CNBC category point totals</span>
    <span class="footer-stack-sep" aria-hidden="true">·</span>
    <span>Match and Founder Lens scores are StateCompass-derived — not CNBC&apos;s official overall rank</span>
  </p>
  <p class="footer-meta">
    Site selection for founders — compare, rank, share CNBC-sourced evidence, and Founder Snapshot context.
  </p>
  <nav class="footer-stack footer-links" aria-label="Site resources">
    <a class="footer-link-btn" href={METHODOLOGY_URL} target="_blank" rel="noopener noreferrer">
      CNBC methodology
    </a>
    <span class="footer-stack-sep" aria-hidden="true">·</span>
    <a class="footer-link-btn" href="/partners">Embed &amp; API for partners</a>
  </nav>
</footer>
