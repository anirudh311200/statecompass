---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="My Founder Profile | StateCompass"
  description="Your saved StateCompass quiz results, top states, Founder Lens, and account settings."
  subtitle="Your saved founder profile"
>
  <main class="page-content profile-page">
    <section class="panel profile-panel" data-profile-page>
      <div data-profile-loading>
        <h1 class="page-title">Loading your profile…</h1>
      </div>

      <div data-profile-signed-out hidden>
        <h1 class="page-title">Redirecting to sign in…</h1>
        <p class="page-lead">Use Sign in in the top-right corner, or continue below.</p>
        <div class="flow-toolbar">
          <a href="/sign-in?redirect_url=%2Fme" class="btn btn-primary">Sign in</a>
          <a href="/sign-up?redirect_url=%2Fme" class="btn btn-secondary">Create account</a>
        </div>
      </div>

      <div data-profile-empty hidden>
        <h1 class="page-title">No saved results yet</h1>
        <p class="page-lead">
          You are signed in, but we do not have a saved quiz snapshot yet. Take the founder match quiz, then save to your account.
        </p>
        <div class="flow-toolbar">
          <a href="/match" class="btn btn-primary">Find your state match</a>
          <a href="/#match-flow" class="btn btn-secondary">Start on homepage</a>
        </div>
      </div>

      <div data-profile-active hidden>
        <h1 class="page-title">Welcome back</h1>
        <p class="page-lead" data-profile-summary></p>

        <div class="profile-top3" data-profile-top3 hidden>
          <h2 class="panel-title">Your top 3 states</h2>
          <div class="profile-top3-cards" data-profile-top3-cards></div>
        </div>

        <div class="profile-actions flow-toolbar">
          <a href="/#match-flow" class="btn btn-primary" data-profile-view-results>View full results</a>
          <a href="/rankings" class="btn btn-secondary" data-profile-lens-link>Rankings with my Lens</a>
          <button type="button" class="btn btn-secondary" data-profile-retake>Edit quiz answers</button>
        </div>

        <div class="profile-manage">
          <h2 class="panel-title">Manage profile</h2>
          <p class="panel-helper">
            Saved for <strong data-profile-email></strong>. Re-taking the quiz overwrites your stored answers and top 3 snapshot.
          </p>
          <div class="profile-manage-actions">
            <button type="button" class="btn btn-ghost profile-delete-btn" data-profile-delete>Delete saved data</button>
          </div>
          <p class="profile-status" data-profile-status role="status" aria-live="polite"></p>
        </div>
      </div>
    </section>
  </main>

  <script>
    import { deleteProfileRemote } from "../scripts/profileSession.js";
    import { bootstrapSavedProfile } from "../scripts/saveProfileFlow.js";
    import { getClerkSessionToken } from "../scripts/clerkClient.js";
    import { getLensLabel } from "../scripts/founderFit.js";
    import { trackProfileReturn, trackProfileDelete } from "../scripts/analytics.js";

    function setStatus(message, tone = "info") {
      const el = document.querySelector("[data-profile-status]");
      if (!el) {
        return;
      }
      el.textContent = message;
      el.dataset.tone = tone;
    }

    function showPanel(name) {
      document.querySelector("[data-profile-loading]")?.toggleAttribute("hidden", name !== "loading");
      document.querySelector("[data-profile-signed-out]")?.toggleAttribute("hidden", name !== "signed-out");
      document.querySelector("[data-profile-empty]")?.toggleAttribute("hidden", name !== "empty");
      document.querySelector("[data-profile-active]")?.toggleAttribute("hidden", name !== "active");
    }

    function renderTop3Cards(top3) {
      const section = document.querySelector("[data-profile-top3]");
      const host = document.querySelector("[data-profile-top3-cards]");
      if (!section || !host || !top3?.length) {
        section?.setAttribute("hidden", "");
        return;
      }

      section.removeAttribute("hidden");
      host.replaceChildren();

      top3.forEach((result, index) => {
        const card = document.createElement("article");
        card.className = "profile-top3-card";
        card.innerHTML = `
          <span class="profile-top3-rank">#${index + 1}</span>
          <h3 class="profile-top3-name">${result.name}</h3>
          <p class="profile-top3-score"><span class="match-score-value">${result.matchScore100}%</span> match</p>
        `;

        const actions = document.createElement("div");
        actions.className = "profile-top3-actions";
        const stateLink = document.createElement("a");
        stateLink.className = "btn btn-secondary btn-sm";
        stateLink.href = `/states/${result.slug}`;
        stateLink.textContent = "State page";
        actions.appendChild(stateLink);
        card.appendChild(actions);

        host.appendChild(card);
      });
    }

    function renderActive(profile) {
      const top = profile.top3Snapshot?.[0];
      const summary = document.querySelector("[data-profile-summary]");
      const emailEl = document.querySelector("[data-profile-email]");
      const lensLink = document.querySelector("[data-profile-lens-link]");

      if (summary && top) {
        summary.textContent = `Your top match is ${top.name} (${top.matchScore100}%). Founder Lens: ${getLensLabel(profile.defaultLens)}.`;
      } else if (summary) {
        summary.textContent = `Founder Lens: ${getLensLabel(profile.defaultLens)}.`;
      }

      if (emailEl) {
        emailEl.textContent = profile.email;
      }

      if (lensLink && profile.defaultLens && profile.defaultLens !== "overall") {
        lensLink.href = `/rankings?lens=${encodeURIComponent(profile.defaultLens)}`;
      }

      renderTop3Cards(profile.top3Snapshot);
    }

    async function boot() {
      const token = await getClerkSessionToken();
      if (!token) {
        window.location.replace("/sign-in?redirect_url=%2Fme");
        return;
      }

      let profile = null;
      try {
        profile = await bootstrapSavedProfile();
      } catch {
        profile = null;
      }

      if (!profile) {
        showPanel("empty");
        return;
      }

      trackProfileReturn();
      renderActive(profile);
      showPanel("active");

      document.querySelector("[data-profile-retake]")?.addEventListener("click", () => {
        window.location.href = "/#match-flow";
      });

      document.querySelector("[data-profile-delete]")?.addEventListener("click", async () => {
        if (!window.confirm("Delete your saved quiz data from StateCompass? This cannot be undone.")) {
          return;
        }
        try {
          await deleteProfileRemote();
          trackProfileDelete();
          setStatus("Saved data deleted.", "success");
          showPanel("empty");
        } catch (error) {
          setStatus(error.message || "Could not delete profile.", "error");
        }
      });
    }

    boot().catch(() => showPanel("signed-out"));
  </script>
</Layout>
