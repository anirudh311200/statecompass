---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import PulseCard from "../components/PulseCard.astro";
import {
  buildPulseStateOverview,
  filterPulseItems,
  pulseDisclaimer,
  pulseIndustries,
  pulseItems,
  PULSE_ACTIVITY_LABELS,
} from "../lib/pulse.js";
import { states } from "../lib/states.js";

const params = Astro.url.searchParams;
const initialState = params.get("state")?.toUpperCase() ?? "";
const initialIndustry = params.get("industry") ?? "";

const stateOptions = Object.entries(states)
  .map(([abbr, state]) => ({ abbr, name: state.name }))
  .sort((a, b) => a.name.localeCompare(b.name));

const stateNames = Object.fromEntries(stateOptions.map(({ abbr, name }) => [abbr, name]));

const filteredItems = filterPulseItems({
  stateAbbr: initialState,
  industry: initialIndustry,
});

const overviewRows = buildPulseStateOverview(stateOptions, undefined, {
  industry: initialIndustry,
});

const title = initialState
  ? `Regulatory Pulse — ${states[initialState]?.name ?? initialState} | StateCompass`
  : "Regulatory Pulse | StateCompass";
const description =
  "Sourced feed of recent regulatory changes by state — privacy, tax, employment, and compliance updates for founders.";
---

<Layout
  title={title}
  description={description}
  subtitle="Recent regulatory changes by state — sourced, not legal advice."
  ogImage="/og/pulse.svg"
  ogImageAlt="StateCompass Regulatory Pulse"
>
  <main class="page-content pulse-page">
    <Breadcrumbs
      crumbs={[
        { label: "Map", href: "/" },
        { label: "Regulatory Pulse" },
      ]}
    />

    <header class="pulse-header">
      <h1 class="page-title">Regulatory Pulse</h1>
      <p class="page-lead">
        Lightweight feed of recent regulatory changes — each item links to an official or reputable source.
      </p>
    </header>

    <section class="panel pulse-overview-wrap" aria-labelledby="pulse-overview-heading">
      <h2 id="pulse-overview-heading" class="panel-title">Pulse by state</h2>
      <p class="panel-helper pulse-overview-helper">
        Curated items in this feed — not a complete count of every regulation. Green = lighter activity, red = more items tracked.
      </p>
      <div class="pulse-overview-table-wrap">
        <table class="rankings-table pulse-overview-table">
          <thead>
            <tr>
              <th scope="col" aria-sort="ascending">
                <button type="button" class="rankings-sort-btn is-sorted" data-pulse-sort="name">
                  <span class="rankings-sort-label">State</span>
                  <span class="rankings-sort-indicator" aria-hidden="true">▲</span>
                </button>
              </th>
              <th scope="col" aria-sort="none">
                <button type="button" class="rankings-sort-btn" data-pulse-sort="count">
                  <span class="rankings-sort-label">Items</span>
                  <span class="rankings-sort-indicator" aria-hidden="true"></span>
                </button>
              </th>
              <th scope="col" aria-sort="none">
                <button type="button" class="rankings-sort-btn" data-pulse-sort="activity">
                  <span class="rankings-sort-label">Activity</span>
                  <span class="rankings-sort-indicator" aria-hidden="true"></span>
                </button>
              </th>
            </tr>
          </thead>
          <tbody data-pulse-overview-body>
            {
              overviewRows.map((row) => (
                <tr
                  class:list={["pulse-overview-row", { "is-selected": row.abbr === initialState }]}
                  data-abbr={row.abbr}
                  data-name={row.name}
                  data-count={row.count}
                  data-tier={row.tier}
                  tabindex="0"
                  role="button"
                  aria-label={`${row.name}, ${row.count} pulse item${row.count === 1 ? "" : "s"}, ${PULSE_ACTIVITY_LABELS[row.tier]} activity`}
                >
                  <td class="pulse-overview-name">{row.name}</td>
                  <td class="pulse-overview-count">{row.count}</td>
                  <td class="pulse-overview-activity">
                    <span class={`pulse-heart pulse-heart--${row.tier}`} aria-hidden="true" />
                    <span class="pulse-activity-label">{PULSE_ACTIVITY_LABELS[row.tier]}</span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <div class="pulse-toolbar panel">
      <div class="pulse-toolbar-item">
        <label class="toolbar-label" for="pulse-state-filter">State</label>
        <select id="pulse-state-filter" class="pulse-select" data-pulse-state>
          <option value="">All states</option>
          {
            stateOptions.map(({ abbr, name }) => (
              <option value={abbr} selected={abbr === initialState}>
                {name}
              </option>
            ))
          }
        </select>
      </div>

      <div class="pulse-toolbar-item">
        <label class="toolbar-label" for="pulse-industry-filter">Industry</label>
        <select id="pulse-industry-filter" class="pulse-select" data-pulse-industry>
          <option value="">All industries</option>
          {
            pulseIndustries.map((tag) => (
              <option value={tag} selected={tag === initialIndustry}>
                {tag}
              </option>
            ))
          }
        </select>
      </div>
    </div>

    <section class="panel pulse-results" id="pulse-feed" aria-labelledby="pulse-results-heading">
      <h2 id="pulse-results-heading" class="visually-hidden">Pulse items</h2>
      <div class="pulse-card-list" data-pulse-list>
        {
          filteredItems.map((item) => (
            <PulseCard
              item={item}
              showState
              stateName={states[item.stateAbbr]?.name ?? item.stateAbbr}
            />
          ))
        }
      </div>
      <p class="pulse-empty" data-pulse-empty hidden={filteredItems.length > 0}>
        No pulse items match these filters.
        <a href="/pulse" class="pulse-empty-link" data-pulse-clear-filters>Clear filters</a>
      </p>
    </section>

    <p class="pulse-digest-note panel-helper">
      Save your founder profile after the match quiz to get return visits — Pulse email digests coming soon.
    </p>

    <p class="flow-disclaimer pulse-page-disclaimer">{pulseDisclaimer}</p>
  </main>

  <script define:vars={{ stateNames, stateOptions, initialState, initialIndustry, pulseItemsData: pulseItems }}>
    import { initPulsePage } from "../scripts/pulsePage.js";

    initPulsePage({
      stateNames,
      stateEntries: stateOptions,
      initialState,
      initialIndustry,
      items: pulseItemsData,
    });
  </script>
</Layout>
