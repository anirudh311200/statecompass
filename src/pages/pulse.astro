---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import {
  buildPulseStateOverview,
  filterPulseItems,
  formatPulseDate,
  formatPulseUpdateCount,
  parsePulseUrlStates,
  pulseDisclaimer,
  pulseIndustries,
  pulseItems,
  PULSE_ACTIVITY_LABELS,
} from "../lib/pulse.js";
import { states } from "../lib/states.js";

const params = Astro.url.searchParams;
const initialStates = parsePulseUrlStates(params);
const initialIndustry = params.get("industry") ?? "";
const initialOpen =
  params
    .get("open")
    ?.split(",")
    .map((abbr) => abbr.trim().toUpperCase())
    .filter(Boolean) ?? (initialStates.length === 1 ? [initialStates[0]] : []);

const stateOptions = Object.entries(states)
  .map(([abbr, state]) => ({ abbr, name: state.name }))
  .sort((a, b) => a.name.localeCompare(b.name));

const overviewRows = buildPulseStateOverview(stateOptions, undefined, {
  industry: initialIndustry,
  stateAbbrs: initialStates.length ? initialStates : null,
});

const title =
  initialStates.length === 1
    ? `Regulatory Pulse — ${states[initialStates[0]]?.name ?? initialStates[0]} | StateCompass`
    : initialStates.length > 1
      ? `Regulatory Pulse — ${initialStates.length} states | StateCompass`
      : "Regulatory Pulse | StateCompass";
const description =
  "Sourced feed of recent regulatory changes by state — privacy, tax, employment, and compliance updates for founders.";
---

<Layout
  title={title}
  description={description}
  subtitle="Recent regulatory changes by state — sourced, not legal advice."
  ogImage="/og/pulse.svg"
  ogImageAlt="StateCompass Regulatory Pulse"
>
  <main class="page-content pulse-page" data-pulse-state-options={JSON.stringify(stateOptions)}>
    <Breadcrumbs
      crumbs={[
        { label: "Map", href: "/" },
        { label: "Regulatory Pulse" },
      ]}
    />

    <header class="pulse-header">
      <h1 class="page-title">Regulatory Pulse</h1>
      <p class="page-lead">
        Lightweight feed of recent regulatory changes — each item links to an official or reputable source.
      </p>
      <p class="panel-helper pulse-legend">
        Heart color shows relative activity in this curated feed (green → yellow → red). Expand a state to read updates.
      </p>
    </header>

    <div class="pulse-filter-bar panel">
      <div class="pulse-filter-item pulse-filter-states">
        <div class="pulse-filter-states-head">
          <span class="toolbar-label pulse-toolbar-label" id="pulse-states-label">Compare states</span>
          <button
            type="button"
            class="btn btn-secondary btn-sm"
            data-pulse-state-open
            aria-haspopup="dialog"
            aria-expanded="false"
            aria-controls="pulse-state-dialog"
          >
            Select states
          </button>
        </div>
        <div class="pulse-state-chips" data-pulse-state-chips hidden></div>
      </div>

      <div class="pulse-filter-item">
        <label class="toolbar-label" for="pulse-industry-filter">Industry</label>
        <select id="pulse-industry-filter" class="pulse-select" data-pulse-industry>
          <option value="">All industries</option>
          {
            pulseIndustries.map((tag) => (
              <option value={tag} selected={tag === initialIndustry}>
                {tag}
              </option>
            ))
          }
        </select>
      </div>
    </div>

    <section class="panel pulse-table-wrap" aria-labelledby="pulse-table-heading">
      <h2 id="pulse-table-heading" class="visually-hidden">Regulatory pulse by state</h2>
      <div class="pulse-table-scroll">
        <table class="rankings-table pulse-table">
          <thead>
            <tr>
              <th scope="col" class="pulse-expand-col"><span class="visually-hidden">Expand</span></th>
              <th scope="col" aria-sort="ascending">
                <button type="button" class="rankings-sort-btn is-sorted" data-pulse-sort="name">
                  <span class="rankings-sort-label">State</span>
                  <span class="rankings-sort-indicator" aria-hidden="true">▲</span>
                </button>
              </th>
              <th scope="col" aria-sort="none" class="pulse-heart-col">
                <button type="button" class="rankings-sort-btn" data-pulse-sort="pulse">
                  <span class="rankings-sort-label">Pulse</span>
                  <span class="rankings-sort-indicator" aria-hidden="true"></span>
                </button>
              </th>
              <th scope="col" aria-sort="none">
                <button type="button" class="rankings-sort-btn" data-pulse-sort="count">
                  <span class="rankings-sort-label">Tracked changes</span>
                  <span class="rankings-sort-indicator" aria-hidden="true"></span>
                </button>
              </th>
            </tr>
          </thead>
          <tbody data-pulse-table-body>
            {
              overviewRows.flatMap((row) => {
                const isExpanded = initialOpen.includes(row.abbr);
                const stateItems = filterPulseItems(
                  { stateAbbr: row.abbr, industry: initialIndustry },
                  pulseItems
                );
                return [
                  <tr class="pulse-state-row" data-abbr={row.abbr} data-tier={row.tier} data-count={row.count}>
                    <td class="pulse-expand-cell">
                      <button
                        type="button"
                        class="pulse-expand-btn"
                        aria-expanded={isExpanded}
                        aria-label={`${isExpanded ? "Collapse" : "Expand"} regulatory updates for ${row.name}`}
                      >
                        <span class="pulse-expand-icon" aria-hidden="true">{isExpanded ? "▾" : "▸"}</span>
                      </button>
                    </td>
                    <td class="pulse-state-name">{row.name}</td>
                    <td class="pulse-heart-cell">
                      <span
                        class={`pulse-heart pulse-heart--${row.tier}`}
                        aria-label={`${PULSE_ACTIVITY_LABELS[row.tier]} regulatory activity`}
                      />
                    </td>
                    <td class="pulse-updates-cell">{formatPulseUpdateCount(row.count)}</td>
                  </tr>,
                  <tr class="pulse-detail-row" data-detail-for={row.abbr} hidden={!isExpanded}>
                    <td colspan="4">
                      <div class="pulse-state-details">
                        {
                          stateItems.length ? (
                            <div class="pulse-card-list pulse-card-list--nested">
                              {stateItems.map((item) => (
                                <article class="pulse-card pulse-card--nested" data-pulse-id={item.id}>
                                  <header class="pulse-card-header">
                                    <h3 class="pulse-card-title">
                                      <a href={item.sourceUrl} target="_blank" rel="noopener noreferrer">
                                        {item.title}
                                      </a>
                                    </h3>
                                  </header>
                                  <p class="pulse-card-summary">{item.summary}</p>
                                  <div class="pulse-card-meta">
                                    <span class="pulse-card-date">
                                      Effective {formatPulseDate(item.effectiveDate)}
                                    </span>
                                    <div class="pulse-card-tags" aria-label="Industry tags">
                                      {item.industries.map((tag) => (
                                        <a
                                          href={`/pulse?industry=${encodeURIComponent(tag)}`}
                                          class="pulse-tag"
                                        >
                                          {tag}
                                        </a>
                                      ))}
                                    </div>
                                  </div>
                                  <p class="pulse-card-source">
                                    Source:{" "}
                                    <a href={item.sourceUrl} target="_blank" rel="noopener noreferrer">
                                      {item.sourceLabel}
                                    </a>
                                  </p>
                                </article>
                              ))}
                            </div>
                          ) : (
                            <p class="pulse-state-details-empty">
                              No regulatory updates match the current industry filter.
                            </p>
                          )
                        }
                      </div>
                    </td>
                  </tr>,
                ];
              })
            }
          </tbody>
        </table>
      </div>
      <p class="pulse-empty" data-pulse-empty hidden={overviewRows.length > 0}>
        No states match these filters.
        <a href="/pulse" class="pulse-empty-link" data-pulse-clear-filters>Clear filters</a>
      </p>
    </section>

    <p class="pulse-digest-note panel-helper">
      Save your founder profile after the match quiz to get return visits — Pulse email digests coming soon.
    </p>

    <p class="flow-disclaimer pulse-page-disclaimer">{pulseDisclaimer}</p>

    <div class="pulse-state-dialog" id="pulse-state-dialog" data-pulse-state-dialog hidden>
      <button
        type="button"
        class="pulse-state-dialog-backdrop"
        data-pulse-state-close
        aria-label="Close state picker"
        tabindex="-1"
      ></button>
      <div
        class="pulse-state-dialog-panel"
        role="dialog"
        aria-modal="true"
        aria-labelledby="pulse-state-dialog-title"
      >
        <header class="pulse-state-dialog-header">
          <h2 id="pulse-state-dialog-title" class="pulse-state-dialog-title">Compare states</h2>
          <button
            type="button"
            class="pulse-state-dialog-close"
            data-pulse-state-close
            aria-label="Close"
          >
            ×
          </button>
        </header>
        <p class="pulse-state-dialog-lead">
          Tap abbreviations to compare — select as many as you like.
        </p>
        <div class="pulse-state-grid" data-pulse-state-grid></div>
        <footer class="pulse-state-dialog-footer">
          <button type="button" class="btn btn-ghost btn-sm" data-pulse-state-clear-all>
            Show all 50 states
          </button>
          <button type="button" class="btn btn-primary btn-sm" data-pulse-state-apply>
            Done
          </button>
        </footer>
      </div>
    </div>
  </main>

  <script>
    import { initPulsePage } from "../scripts/pulsePage.js";

    initPulsePage().catch((error) => console.error("Pulse page init failed:", error));
  </script>
</Layout>
