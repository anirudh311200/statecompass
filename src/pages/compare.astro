---
import Layout from "../layouts/Layout.astro";
import FounderFitSelector from "../components/FounderFitSelector.astro";
import { dataYear } from "../lib/states.js";
---

<Layout
  title={`Compare States — CNBC ${dataYear} | StateCompass`}
  description="Compare 2–3 US states side by side on CNBC business climate scores and all 10 category rankings. Shareable link for co-founders and board decks."
  subtitle="Compare up to 3 states on CNBC scores and category ranks."
  ogImage="/og/compare.svg"
  ogImageAlt="Compare US states — CNBC rankings for founders"
>
  <main class="page-content compare-page">
    <div class="compare-controls panel">
      <div class="compare-controls-header">
        <h1 class="page-title">Compare states</h1>
        <p class="page-lead">
          Side-by-side CNBC {dataYear} scores — share the URL with your co-founder.
        </p>
      </div>

      <FounderFitSelector id="compare-profile" class="compare-founder-fit" />

      <div class="compare-slots" id="compare-slots">
        <div class="compare-slot" data-slot="0">
          <label class="compare-slot-label" for="compare-select-0">State 1</label>
          <select id="compare-select-0" class="compare-select">
            <option value="">Select a state…</option>
          </select>
        </div>
        <div class="compare-slot" data-slot="1">
          <label class="compare-slot-label" for="compare-select-1">State 2</label>
          <select id="compare-select-1" class="compare-select">
            <option value="">Select a state…</option>
          </select>
        </div>
        <div class="compare-slot compare-slot--optional" data-slot="2">
          <label class="compare-slot-label" for="compare-select-2">State 3 (optional)</label>
          <select id="compare-select-2" class="compare-select">
            <option value="">None</option>
          </select>
        </div>
      </div>

      <div class="compare-chips" id="compare-chips" hidden></div>

      <div class="share-bar" id="compare-share-bar" hidden>
        <button
          type="button"
          class="btn btn-secondary"
          id="copy-compare-link"
          data-default-label="Copy compare link"
        >
          Copy compare link
        </button>
        <button type="button" class="btn btn-secondary" id="print-compare">
          Print / save PDF
        </button>
        <button
          type="button"
          class="btn btn-secondary"
          id="download-compare-png"
          data-default-label="Save as PNG"
        >
          Save as PNG
        </button>
        <p id="compare-share-status" class="share-status" role="status" aria-live="polite"></p>
      </div>
    </div>

    <div id="compare-empty" class="compare-empty panel">
      <p>Select at least two states above to compare scores and categories.</p>
    </div>

    <div id="compare-results" class="compare-results" hidden aria-live="polite">
      <section class="panel compare-print-header" aria-hidden="true">
        <p class="compare-print-brand">StateCompass · CNBC {dataYear}</p>
        <h2 class="compare-print-title">State comparison</h2>
      </section>

      <section class="panel" aria-labelledby="compare-summary-heading">
        <h2 id="compare-summary-heading" class="panel-title">Overall</h2>
        <div class="compare-summary-grid" id="compare-summary"></div>
      </section>

      <section class="panel" aria-labelledby="compare-categories-heading">
        <h2 id="compare-categories-heading" class="panel-title">By category</h2>
        <p class="panel-helper">Winner highlighted per category (best rank wins).</p>
        <div id="compare-categories"></div>
      </section>

      <p class="compare-export-footer" id="compare-export-footer">
        <span class="compare-export-label">Compare link · CNBC {dataYear}</span>
        <span class="compare-export-url" id="compare-export-url"></span>
      </p>

      <p id="compare-live-status" class="visually-hidden" aria-live="polite"></p>
    </div>
  </main>

  <script>
    import { initCompare } from "../scripts/compare.js";
    initCompare().catch((error) => console.error(error));
  </script>
</Layout>
