---
import Layout from "../layouts/Layout.astro";
import FounderFitSelector from "../components/FounderFitSelector.astro";
import YearSelector from "../components/YearSelector.astro";
import { getStateList, dataYear } from "../lib/states.js";
import { TIER_LABELS, TIER_FILTER_LABELS } from "../scripts/categories.js";

const stateList = getStateList().sort((a, b) => a.rank - b.rank);

const tierFilters = [
  { tier: "green", label: TIER_FILTER_LABELS.green },
  { tier: "yellow", label: TIER_FILTER_LABELS.yellow },
  { tier: "red", label: TIER_FILTER_LABELS.red },
] as const;
---

<Layout
  title={`State Rankings — CNBC ${dataYear} | StateCompass`}
  description="Full CNBC America's Top States for Business 2025 rankings. Sort and filter all 50 states by rank, score, or tier — or re-rank with a Founder Lens."
  subtitle="Overall CNBC rankings or Founder Lens for your founder type."
  rankingsPage
>
  <main class="page-content rankings-page">
    <header class="rankings-header">
      <h1 class="page-title">Rankings</h1>
      <p class="page-lead" id="rankings-mode-label">
        CNBC America's Top States for Business, {dataYear} — click a row for the full breakdown.
      </p>
    </header>

    <div class="rankings-toolbar panel">
      <YearSelector id="rankings-year" />

      <FounderFitSelector id="rankings-profile" />

      <div class="rankings-filter">
        <span class="toolbar-label">Filter by tier</span>
        <div class="tier-filter-group" role="group" aria-label="Filter by tier">
          <button type="button" class="tier-filter-btn is-active" data-tier="all">
            All
          </button>
          {
            tierFilters.map(({ tier, label }) => (
              <button type="button" class="tier-filter-btn" data-tier={tier}>
                <span class={`tier-filter-swatch ${tier}`} aria-hidden="true" />
                <span class="tier-filter-label tier-filter-label--long">{label}</span>
                <span class="tier-filter-label tier-filter-label--short">
                  {TIER_LABELS[tier]}
                </span>
              </button>
            ))
          }
        </div>
      </div>
    </div>

    <div class="panel rankings-table-wrap">
      <table class="rankings-table" id="rankings-table">
        <thead>
          <tr>
            <th scope="col" aria-sort="ascending">
              <button
                type="button"
                class="rankings-sort-btn is-sorted"
                data-sort="rank"
                id="rankings-rank-header"
              >
                <span class="rankings-sort-label">Rank</span>
                <span class="rankings-sort-indicator" aria-hidden="true">▲</span>
              </button>
            </th>
            <th scope="col" aria-sort="none">
              <button type="button" class="rankings-sort-btn" data-sort="name" id="rankings-name-header">
                <span class="rankings-sort-label">State</span>
                <span class="rankings-sort-indicator" aria-hidden="true"></span>
              </button>
            </th>
            <th scope="col" aria-sort="none">
              <button type="button" class="rankings-sort-btn" data-sort="score" id="rankings-score-header">
                <span class="rankings-sort-label">Score</span>
                <span class="rankings-sort-indicator" aria-hidden="true"></span>
              </button>
            </th>
            <th scope="col" id="rankings-cnbc-header-col" hidden aria-sort="none">
              <button type="button" class="rankings-sort-btn" data-sort="cnbc" id="rankings-cnbc-header">
                <span class="rankings-sort-label">CNBC rank</span>
                <span class="rankings-sort-indicator" aria-hidden="true"></span>
              </button>
            </th>
            <th scope="col" class="rankings-tier-col">Tier</th>
          </tr>
        </thead>
        <tbody id="rankings-body">
          {
            stateList.map((state) => (
              <tr
                class="rankings-row"
                data-abbr={state.abbr}
                data-tier={state.tier}
                data-rank={state.rank}
                data-score={state.score100}
                data-cnbc-rank={state.rank}
                data-cnbc-score={state.score100}
                data-name={state.name}
                data-slug={state.slug}
                tabindex="0"
                role="link"
                aria-label={`${state.name}, rank ${state.rank}, ${TIER_LABELS[state.tier]}, score ${state.score100} out of 100`}
              >
                <td class="rankings-rank">#{state.rank}</td>
                <td class="rankings-name">{state.name}</td>
                <td class="rankings-score">{state.score100}/100</td>
                <td class="rankings-cnbc" hidden></td>
                <td class="rankings-tier-col">
                  <span class={`tier-badge tier-badge--sm ${state.tier}`}>
                    {TIER_LABELS[state.tier]}
                  </span>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <p id="rankings-empty" class="rankings-empty" hidden>
        No states match this filter.
      </p>
    </div>
  </main>

  <script>
    import { initRankings } from "../scripts/rankings.js";
    initRankings().catch((error) => console.error(error));
  </script>
</Layout>
