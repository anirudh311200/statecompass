---
import Layout from "../layouts/Layout.astro";
import FounderFitSelector from "../components/FounderFitSelector.astro";
import YearSelector from "../components/YearSelector.astro";
import { getStateList, dataYear } from "../lib/states.js";
import { TIER_LABELS, TIER_FILTER_LABELS } from "../scripts/categories.js";

const stateList = getStateList().sort((a, b) => a.rank - b.rank);
---

<Layout
  title={`State Rankings — CNBC ${dataYear} | StateCompass`}
  description="Full CNBC America's Top States for Business 2025 rankings. Sort and filter all 50 states by rank, score, or tier — or re-rank by founder business profile."
  subtitle="Overall CNBC rankings or Founder Fit for your business type."
>
  <main class="page-content rankings-page">
    <header class="rankings-header">
      <h1 class="page-title">Rankings</h1>
      <p class="page-lead" id="rankings-mode-label">
        CNBC America's Top States for Business, {dataYear} — click a row for the full breakdown.
      </p>
    </header>

    <div class="rankings-toolbar panel">
      <YearSelector id="rankings-year" />

      <FounderFitSelector id="rankings-profile" />

      <div class="rankings-filter">
        <span class="toolbar-label">Filter by tier</span>
        <div class="tier-filter-group" role="group" aria-label="Filter by tier">
          <button type="button" class="tier-filter-btn is-active" data-tier="all">
            All
          </button>
          <button type="button" class="tier-filter-btn" data-tier="green">
            {TIER_FILTER_LABELS.green}
          </button>
          <button type="button" class="tier-filter-btn" data-tier="yellow">
            {TIER_FILTER_LABELS.yellow}
          </button>
          <button type="button" class="tier-filter-btn" data-tier="red">
            {TIER_FILTER_LABELS.red}
          </button>
        </div>
      </div>

      <div class="rankings-sort">
        <label class="toolbar-label" for="rankings-sort">Sort by</label>
        <select id="rankings-sort" class="rankings-sort-select">
          <option value="rank">Rank (default)</option>
          <option value="score">Score</option>
          <option value="name">State name</option>
          <option value="cnbc">CNBC rank</option>
        </select>
      </div>
    </div>

    <div class="panel rankings-table-wrap">
      <table class="rankings-table" id="rankings-table">
        <thead>
          <tr>
            <th scope="col" id="rankings-rank-header" class="is-sorted">Rank</th>
            <th scope="col">State</th>
            <th scope="col" id="rankings-score-header">Score</th>
            <th scope="col" id="rankings-cnbc-header" hidden>CNBC rank</th>
            <th scope="col">Tier</th>
          </tr>
        </thead>
        <tbody id="rankings-body">
          {
            stateList.map((state) => (
              <tr
                class="rankings-row"
                data-abbr={state.abbr}
                data-tier={state.tier}
                data-rank={state.rank}
                data-score={state.score100}
                data-cnbc-rank={state.rank}
                data-cnbc-score={state.score100}
                data-name={state.name}
                data-slug={state.slug}
                tabindex="0"
                role="link"
                aria-label={`${state.name}, rank ${state.rank}, score ${state.score100} out of 100`}
              >
                <td class="rankings-rank">#{state.rank}</td>
                <td class="rankings-name">{state.name}</td>
                <td class="rankings-score">{state.score100}/100</td>
                <td class="rankings-cnbc" hidden></td>
                <td>
                  <span class={`tier-badge tier-badge--sm ${state.tier}`}>
                    {TIER_LABELS[state.tier]}
                  </span>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <p id="rankings-empty" class="rankings-empty" hidden>
        No states match this filter.
      </p>
    </div>
  </main>

  <script>
    import { initRankings } from "../scripts/rankings.js";
    initRankings().catch((error) => console.error(error));
  </script>
</Layout>
