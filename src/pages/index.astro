---
import Layout from "../layouts/Layout.astro";
import FounderFitSelector from "../components/FounderFitSelector.astro";
import YearSelector from "../components/YearSelector.astro";
import StateSearch from "../components/StateSearch.astro";
import SavedPanel from "../components/SavedPanel.astro";
import SaveProfilePanel from "../components/SaveProfilePanel.astro";
import { SEARCH_FAVICON_PNG, SITE_NAME } from "../lib/site.js";

const site = Astro.site ?? new URL("https://statecompass.app");
const homeDescription =
  "Find your best US state for HQ — take the founder quiz for personalized match scores, then explore CNBC business climate data for all 50 states.";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${site.href}#website`,
      name: SITE_NAME,
      url: site.href,
      description: homeDescription,
      publisher: { "@id": `${site.href}#organization` },
    },
    {
      "@type": "Organization",
      "@id": `${site.href}#organization`,
      name: SITE_NAME,
      url: site.href,
      logo: {
        "@type": "ImageObject",
        url: new URL(SEARCH_FAVICON_PNG, site).href,
        width: 192,
        height: 192,
      },
    },
  ],
};
---

<Layout
  homePage
  preloadData
  subtitle="Find your state match — personalized for founders."
  description={homeDescription}
  jsonLd={jsonLd}
>
  <section class="profile-return panel" data-profile-return hidden aria-live="polite">
    <div class="profile-return-inner">
      <p class="profile-return-text" data-profile-return-text></p>
      <div class="profile-return-actions">
        <a href="#match-flow" class="btn btn-primary btn-sm" data-profile-return-cta>View my top 3</a>
        <a href="/me" class="btn btn-secondary btn-sm">Manage profile</a>
      </div>
    </div>
  </section>

  <section class="match-hero panel" id="match-flow" data-match-container>
    <div data-match-hero class="match-hero-inner">
      <h1 class="match-hero-title">Where should you build?</h1>
      <p class="match-hero-lead">
        Answer 7 quick questions — get your top 3 states with match scores, plain-English reasons, and a zoom into cities that fit your profile.
      </p>
      <div class="match-hero-actions">
        <button type="button" class="btn btn-primary btn-lg" data-start-quiz>
          Find your state match
        </button>
        <button type="button" class="btn btn-secondary" data-resume-quiz hidden>
          Continue quiz
        </button>
      </div>
      <p class="match-hero-note">StateCompass derived scores — not CNBC's official overall rank.</p>
    </div>

    <div data-match-quiz class="match-quiz" hidden>
      <div class="match-quiz-header">
        <button type="button" class="btn btn-ghost match-quiz-back" data-quiz-back>← Back</button>
        <button type="button" class="btn btn-ghost" data-quiz-cancel>Cancel</button>
      </div>
      <div
        class="match-quiz-progress"
        data-quiz-progress
        role="progressbar"
        aria-valuemin="1"
        aria-valuemax="7"
        aria-valuenow="1"
      ></div>
      <h2 class="match-quiz-title" data-quiz-title tabindex="-1"></h2>
      <div class="match-quiz-options" data-quiz-options role="group"></div>
    </div>

    <div data-match-results class="match-results" hidden>
      <div class="match-results-header">
        <h2 class="match-results-title">Your top 3 states</h2>
        <div class="match-results-toolbar">
          <button type="button" class="btn btn-secondary" data-copy-match-link data-default-label="Copy results link">
            Copy results link
          </button>
          <button type="button" class="btn btn-secondary" data-edit-quiz>Edit answers</button>
          <button type="button" class="btn btn-secondary" data-retake-quiz>Re-take quiz</button>
          <a href="/compare" class="btn btn-secondary" data-compare-top3 hidden>Compare top 3</a>
        </div>
        <p class="share-status" data-share-status role="status" aria-live="polite"></p>
        <p class="match-disclaimer">{`Derived from CNBC category scores — not CNBC's official overall rank.`}</p>
        <p class="match-lens-note founder-fit-disclaimer" data-match-lens-note hidden></p>
      </div>
      <p class="visually-hidden" data-results-live aria-live="polite"></p>
      <div class="match-result-cards" data-result-cards></div>
      <SaveProfilePanel class="match-save-profile" />
    </div>
  </section>

  <main class="layout layout--home">
    <div class="map-column">
      <section class="map-panel" aria-label="United States map" data-match-map-section>
        <div class="state-focus-toolbar" id="state-focus-toolbar" hidden>
          <span class="state-focus-label">State Focus Mode</span>
          <button type="button" class="btn btn-secondary btn-sm" id="exit-state-focus">
            Reset map
          </button>
        </div>
        <span id="map-title" hidden>United States business climate map</span>
        <span id="map-desc" hidden>
          Search or click a state to preview rank and score. Open the full state page for all 10 categories and Founder Snapshot.
        </span>
        <div id="map-container" aria-hidden="false"></div>

        <div class="map-toolbar" aria-label="Map controls">
          <div class="map-toolbar-controls">
            <StateSearch variant="map" />
            <YearSelector id="map-year" variant="compact" class="map-year-select" />
          </div>

          <span class="map-legend-sep map-legend-sep--toolbar" aria-hidden="true">·</span>

          <div class="map-legend map-legend--inline" aria-label="Map color legend">
            <div class="map-legend-items">
              <span class="map-legend-item">
                <span class="swatch green" aria-hidden="true"></span>
                <span>1–17</span>
              </span>
              <span class="map-legend-item">
                <span class="swatch yellow" aria-hidden="true"></span>
                <span>18–34</span>
              </span>
              <span class="map-legend-item">
                <span class="swatch red" aria-hidden="true"></span>
                <span>35–50</span>
              </span>
            </div>
          </div>
        </div>
      </section>
    </div>

    <aside class="sidebar" id="sidebar">
      <div class="info-card match-metro-panel" id="match-metro-panel" hidden>
        <h2 class="match-metro-heading">Metro areas · <span data-metro-state-name></span></h2>
        <p class="match-metro-best" data-metro-best-line hidden></p>
        <ul class="metro-list" data-metro-list></ul>
        <p class="match-metro-note">Metro strengths are curated context — not CNBC rankings.</p>
      </div>

      <div class="info-card" id="info-card" aria-live="polite">
        <div class="mobile-sheet-grabber" id="mobile-sheet-grabber" aria-hidden="true">
          <span class="mobile-sheet-grabber-bar"></span>
        </div>
        <div class="info-card-header">
          <h2>State details</h2>
          <button type="button" id="clear-pin" class="clear-pin-btn" hidden>
            Clear
          </button>
        </div>
        <p id="tooltip-default" class="tooltip-prompt">
          <span class="tooltip-prompt-row">
            <span class="prompt-dot" aria-hidden="true"></span>
            <span>Search or click a state to preview rank and score.</span>
          </span>
          <span class="tooltip-prompt-secondary">
            Open the full state page for Founder Snapshot.
          </span>
        </p>
        <div id="tooltip-content" hidden>
          <FounderFitSelector variant="pills" id="map-profile" showDisclaimer />

          <div class="state-name-row">
            <p class="state-name">
              <a href="#" id="state-name-link" class="state-name-link"></a>
            </p>
            <button
              type="button"
              id="bookmark-state"
              class="bookmark-btn"
              hidden
              aria-pressed="false"
              aria-label="Save state for later"
              title="Save for later"
            >
              <span class="bookmark-icon" aria-hidden="true">☆</span>
            </button>
          </div>

          <a href="#" id="map-detail-link" class="map-detail-link map-detail-link--primary">
            Full breakdown &amp; Founder Snapshot →
          </a>

          <a href="#" id="map-report-card-link" class="map-detail-link">
            Download report card →
          </a>

          <div class="score-block">
            <div class="score-header">
              <span class="score-label" id="score-label">Score</span>
              <span class="score-value" id="score-value"></span>
              <span class="score-max">/100</span>
            </div>
            <div class="score-bar-track" aria-hidden="true">
              <div class="score-bar-fill" id="score-bar-fill"></div>
            </div>
          </div>

          <p class="rank-row">
            Rank <span id="rank-value"></span>
          </p>
          <p class="rank-footnote" id="rank-footnote" hidden></p>

          <span class="profile-chip" id="profile-chip" hidden></span>
          <span class="tier-badge" id="tier-badge"></span>

          <details class="category-details" id="category-details" hidden>
            <summary class="category-details-summary">Category breakdown</summary>
            <div class="category-details-body">
              <div class="category-group">
                <h3 class="category-heading">Top strengths</h3>
                <div id="category-strengths"></div>
              </div>
              <div class="category-group">
                <h3 class="category-heading">Areas to improve</h3>
                <div id="category-weaknesses"></div>
              </div>
              <p class="category-methodology">
                <a
                  href="https://www.cnbc.com/2025/06/11/how-we-are-choosing-americas-top-states-for-business-in-2025.html"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Methodology
                </a>
                — 10 categories, 2,500 points max
              </p>
            </div>
          </details>

          <div class="map-snapshot-teaser" id="map-snapshot-teaser">
            <p class="map-snapshot-teaser-title">Founder Snapshot</p>
            <p class="map-snapshot-teaser-text">
              Tax posture, business registration, compliance calendar, and multi-state heads-up — on the full state page.
            </p>
          </div>
        </div>
      </div>

      <SavedPanel />
    </aside>
  </main>

  <script>
    import { initMap } from "../scripts/map.js";
    import { initSearch } from "../scripts/search.js";
    import { initMapSidebar } from "../scripts/mapSidebar.js";
    import { initMatchFlow } from "../scripts/matchFlow.js";
    import { initStateFocus, loadMetrosData, enterStateFocus } from "../scripts/stateFocus.js";
    import { pinState } from "../scripts/map.js";
    import { loadQuizProgress } from "../scripts/quizStore.js";
    import { decodeQuizFromParams } from "../scripts/founderMatch.js";
    import { bootstrapSavedProfile } from "../scripts/saveProfileFlow.js";
    import { getCachedProfile, getSessionToken } from "../scripts/profileSession.js";
    import { trackProfileReturn } from "../scripts/analytics.js";

    function renderProfileReturn(profile) {
      const banner = document.querySelector("[data-profile-return]");
      const text = document.querySelector("[data-profile-return-text]");
      const top = profile?.top3Snapshot?.[0];
      if (!banner || !text || !top) {
        return;
      }

      text.textContent = `Welcome back — your top match is ${top.name} (${top.matchScore100}%).`;
      banner.hidden = false;
      trackProfileReturn();
    }

    async function hydrateProfileReturn() {
      const token = new URLSearchParams(window.location.search).get("token");
      if (token) {
        return;
      }

      const cached = getCachedProfile();
      if (cached?.top3Snapshot?.length) {
        renderProfileReturn(cached);
        return;
      }

      if (!getSessionToken()) {
        return;
      }

      try {
        const profile = await bootstrapSavedProfile();
        if (profile) {
          renderProfileReturn(profile);
        }
      } catch {
        /* profile service unavailable */
      }
    }

    async function boot() {
      await loadMetrosData();
      initStateFocus();

      const stateData = await initMap();
      initSearch(stateData);
      initMapSidebar(stateData);

      const container = document.getElementById("match-flow");
      const params = new URLSearchParams(window.location.search);
      const tokenFromUrl = params.get("token");

      if (tokenFromUrl) {
        window.location.replace(`/me?token=${encodeURIComponent(tokenFromUrl)}`);
        return;
      }

      if (getSessionToken()) {
        try {
          await bootstrapSavedProfile();
        } catch {
          /* profile service unavailable */
        }
      }

      const urlAnswers = decodeQuizFromParams(window.location.search);
      initMatchFlow({
        container,
        statesObject: stateData,
        initialAnswers: urlAnswers,
        onResultsShown: () => {
          document.getElementById("state-focus-toolbar")?.removeAttribute("hidden");
        },
      });

      await hydrateProfileReturn();

      const focusState = params.get("state")?.toUpperCase();
      const shouldFocus = params.get("focus") === "1";
      if (focusState && shouldFocus && urlAnswers) {
        document.getElementById("state-focus-toolbar")?.removeAttribute("hidden");
        enterStateFocus(focusState, urlAnswers);
        pinState(focusState, { skipUrl: true, focusSidebar: true });
        params.delete("focus");
        history.replaceState(null, "", `${window.location.pathname}?${params.toString()}`);
      } else if (focusState) {
        pinState(focusState, { skipUrl: true });
      }

      const progress = loadQuizProgress();
      const resumeBtn = container?.querySelector("[data-resume-quiz]");
      if (resumeBtn && progress?.answers && progress.stepIndex >= 0) {
        resumeBtn.hidden = false;
      }

      document.addEventListener("statecompass:state-focus", () => {
        document.getElementById("state-focus-toolbar")?.removeAttribute("hidden");
      });
      document.addEventListener("statecompass:state-focus-clear", () => {
        document.getElementById("state-focus-toolbar")?.setAttribute("hidden", "");
      });
    }

    boot().catch((error) => {
      console.error(error);
      const defaultText = document.getElementById("tooltip-default");
      if (defaultText) {
        defaultText.textContent = "Unable to load map data. Please refresh the page.";
      }
    });
  </script>
</Layout>
