---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/styles.css";
import "@fontsource/sora/400.css";
import "@fontsource/sora/500.css";
import "@fontsource/sora/600.css";
import "@fontsource/sora/700.css";

interface Props {
  title?: string;
  description?: string;
  homePage?: boolean;
  rankingsPage?: boolean;
  subtitle?: string;
  ogImage?: string;
  ogImageAlt?: string;
  preloadData?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = "StateCompass",
  description = "Compare US states for HQ and expansion — CNBC scores, Founder Snapshot operational context, and shareable compare links for founders.",
  homePage = false,
  rankingsPage = false,
  subtitle,
  ogImage = "/og/default.svg",
  ogImageAlt = "StateCompass — site selection for founders",
  preloadData = false,
  jsonLd,
} = Astro.props;

const site = Astro.site ?? new URL("https://statecompass.app");
const canonical = new URL(Astro.url.pathname, site).href;
const ogImageUrl = new URL(ogImage, site).href;
const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.svg" sizes="180x180" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {
      preloadData && (
        <link rel="preload" href="/data/states-index.json" as="fetch" crossorigin="anonymous" />
        <link rel="preload" href="/data/states.json" as="fetch" crossorigin="anonymous" />
      )
    }
    {
      jsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      )
    }
  </head>
  <body>
    <div class:list={["page", { "page--home": homePage, "page--rankings": rankingsPage }]}>
      <Header compact={homePage} subtitle={subtitle} />
      <slot />
      <Footer />
    </div>
    {
      plausibleDomain && (
        <script
          defer
          data-domain={plausibleDomain}
          src="https://plausible.io/js/script.js"
        />
      )
    }
  </body>
</html>
