# Canonical production URL (used for sitemap + Open Graph)
SITE_URL=https://statecompass.app

# Optional: enable Plausible analytics (your domain, e.g. statecompass.app)
# PUBLIC_PLAUSIBLE_DOMAIN=statecompass.app

# Optional: Buttondown (or ConvertKit) form action URL for "notify me when next CNBC year drops"
# PUBLIC_BUTTONDOWN_URL=https://buttondown.com/api/emails/embed-subscribe/your-newsletter

# Feature 6 — Save My Profile (Vercel serverless + Upstash Redis + Clerk auth)
# PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
# CLERK_SECRET_KEY=sk_live_...
# UPSTASH_REDIS_REST_URL=https://example.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token
# PROFILE_STATS_SECRET=long-random-string-for-internal-stats
